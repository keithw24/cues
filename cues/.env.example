# Photon/Spectrum project identifier.
# Safe to treat as non-secret, but keep it in backend config for consistency.
SPECTRUM_PROJECT_ID=

# Photon/Spectrum project secret.
# Backend-only. Never expose this through NEXT_PUBLIC_* variables or frontend code.
SPECTRUM_PROJECT_SECRET=

# Demo/test teacher destination for Photon iMessage alerts.
# Must be opted in / allowlisted under Spectrum Users.
# This is temporary until teacher phone numbers are stored per authenticated teacher.
SPECTRUM_TEACHER_PHONE=

# Optional dedicated Spectrum sending line.
# Leave blank if the project has only one/default sender.
SPECTRUM_SENDER_PHONE=