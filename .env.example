# The one env file for the whole repo: vision, the agent, the dashboard, the text-message
# sender and the scripts all read this file. Copy it to .env and never commit .env.
# Values already set in your shell win over this file.

# ---- Supabase (local: `supabase status` prints these) -------------------------------
# Backend (vision, agent, dashboard server routes). The secret key bypasses every row
# security rule: never put it in a NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe: sent to the dashboard in the page. Same project as above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: Postgres connection, for scripts/supabase-migrations.py only.
DATABASE_URL=

# ---- LLM provider used by the agent worker ------------------------------------------
GROQ_API_KEY=

# ---- Teacher text messages (Photon / Spectrum), optional ----------------------------
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Optional dedicated sender
SPECTRUM_SENDER_PHONE=
# 1 = send every alert to SPECTRUM_TEACHER_PHONE (local testing); 0 = the signed-in
# teacher's saved profile phone
CUES_USE_STATIC_TEACHER_PHONE=0
SPECTRUM_TEACHER_PHONE=

# ---- Camera and vision, optional ----------------------------------------------------
# Webcam number (USB cameras are often 1), or CUES_CAMERA=fake for no camera
CUES_CAMERA_INDEX=
# CUES_CAMERA=fake
# CUES_OVERLAY=debug
# CUES_PALM_FLIP=1

# ---- Dev/test only ------------------------------------------------------------------
# Pin vision to one station / follow one session instead of the signed-in teacher's own.
# CUES_STATION_ID=S1
# CUES_SESSION_ID=
# Pin the dashboard to one station.
# CUES_STATION_OVERRIDE=S1
