# Supabase backend
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider used by the live agent runtime
GROQ_API_KEY=

# Optional legacy/smoke session identity; managed dev/demo resolves sessions dynamically
CUES_SESSION_ID=

# Vision → Supabase publishing (0 or 1)
CUES_FLAG_VISION_SUPABASE_EVENTS=

# Vision reads sessions.current_activity_id from Supabase (0 or 1)
CUES_FLAG_VISION_ACTIVITY_SYNC=

CUES_FLAG_VISION_SESSION_LIFECYCLE=

# Optional grouping/config mode used by vision/runtime
CUES_GROUPING=