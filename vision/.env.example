# Copy to vision/.env and fill in. vision/.env is git-ignored.
# Without SUPABASE_URL/SUPABASE_KEY, events are written to vision/logs/*.jsonl.

SUPABASE_URL=
# Service-role key for the station laptop (never ship it to the browser).
SUPABASE_KEY=

# Station and session ids written into every event.
CUES_STATION_ID=S1
# Leave empty to create a new session id on each start.
CUES_SESSION_ID=

# Camera: index of the webcam (Logitech is often 1 on a MacBook), or CUES_CAMERA=fake.
CUES_CAMERA_INDEX=0
