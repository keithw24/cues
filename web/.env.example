NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side gate; defaults off in flags.json. Restart after changing it.
CUES_FLAG_WEB_DASHBOARD=0

# Pending Michelle-side teacher_reviews persistence/RLS/Realtime; defaults off.
CUES_FLAG_WEB_TEACHER_REVIEWS=0
# Enable only after deploying the authorized pending-only resolve_teacher_review RPC.
CUES_FLAG_WEB_TEACHER_REVIEW_ACTIONS=0
# Requires migration 003, an Auth user, and station_teachers membership.
CUES_FLAG_WEB_SESSION_CONTROLS=0
CUES_STATION_ID=S1

# Animated login companion and sign-in for existing Supabase teacher accounts.
# Presentation only; station permissions still come from station_teachers.
CUES_FLAG_WEB_TEACHER_LOGIN=0
# Requires tracking_valid + person metadata (migration 004). Five-second display freshness only.
CUES_FLAG_WEB_PERSON_OBSERVATIONS=0
