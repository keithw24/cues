# Optional: direct Postgres connection used for migrations/admin tooling.
# Not required for normal dashboard startup.
DATABASE_URL=

# Browser-safe Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe Supabase publishable key.
# Do not put the service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side dashboard feature gate.
# Defaults off in flags.json; restart the web app after changing it.
CUES_FLAG_WEB_DASHBOARD=0

# Enable existing dashboard testing controls after required RPC migrations deploy.
# A signed-in teacher's own default station is found (and created on first sign-in)
# automatically. Set CUES_STATION_OVERRIDE only to point a dev/test dashboard at one
# explicit station; it replaces that lookup. (Vision learns the station from the
# dashboard; CUES_STATION_ID in the root .env only pins a laptop to one station.)
# CUES_STATION_OVERRIDE=S1
CUES_FLAG_WEB_SESSION_CONTROLS=0
CUES_FLAG_WEB_PERSON_OBSERVATIONS=0
CUES_FLAG_WEB_TEACHER_REVIEWS=0
CUES_FLAG_WEB_TEACHER_REVIEW_ACTIONS=0
CUES_FLAG_WEB_TEACHER_LOGIN=0
CUES_FLAG_WEB_TEACHER_PROFILE=0
