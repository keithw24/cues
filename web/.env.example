# Browser-safe Supabase URL and publishable key (local: `supabase status`).
# Never put the service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: used by the notification routes.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Postgres connection for scripts/supabase-migrations.py only.
DATABASE_URL=

# Dev/test only: pin the dashboard to one station instead of the signed-in teacher's own.
# CUES_STATION_OVERRIDE=S1
