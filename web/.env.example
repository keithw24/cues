# Optional: direct Postgres connection used for migrations/admin tooling.
# Not required for normal dashboard startup.
DATABASE_URL=

# Browser-safe Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe Supabase publishable key.
# Do not put the service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side dashboard feature gate.
# Defaults off in flags.json; restart the web app after changing it.
CUES_FLAG_WEB_DASHBOARD=0
