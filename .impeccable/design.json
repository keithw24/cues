  "narrative": {
    "northStar": "The Classroom in View",
    "overview": "Cues uses the Columbia Catalog / LionPlan reference as the authority for quiet operational software: white content, cool neutral framing, upright Inter, navy selection and compact rounded controls. A persistent workspace rail gives classroom monitoring, people, teacher reviews and notifications a clear home. The camera and review queue carry the work; activity controls open only when requested. This code-led reference adaptation supersedes the earlier Nexus mesh tiles and italic type, and makes no pixel-exact reproduction claim.\n\nThe sign-in surface is focused and friendly: one question at a time beneath an illustrated Cues companion. The character belongs to the product, never to a teacher profile or learner identity. Its animation supports the interaction without changing what the system knows. Structured state, honest unavailable states, position-based identification and teacher authorization remain product boundaries rather than decorative implications.",
    "keyCharacteristics": [
      "White and cool-neutral surfaces with navy actions and selection.",
      "Upright Inter, fine borders and compact rectangular controls.",
      "A persistent desktop rail that becomes a compact mobile header/navigation.",
      "Scan-friendly people rows and progressive activity disclosure.",
      "A browser-rendered login companion with restrained gaze and a sleeping password state."
    ],
    "rules": [
      {
        "name": "The State Comes From Text Rule",
        "body": "Color supports explicit labels; it never establishes task difficulty, learner identity or an emotional diagnosis.",
        "section": "colors"
      },
      {
        "name": "The One Typeface Rule",
        "body": "Use upright Inter throughout the workspace and login; hierarchy comes from size, weight and spacing.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use borders and tonal separation for containment; the current interface has no cast-shadow vocabulary.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use navy for selected navigation and consequential actions, with explicit text labels.",
      "Do preserve the 4:3 local video viewport, SIM provenance and separate connection feedback.",
      "Do keep activity controls inside their disclosure and people in compact rows.",
      "Do retain keyboard focus, mobile account access, wrapping and reduced-motion behavior.",
      "Do treat the login companion as a product character, with password privacy and flag-off fallback.",
      "Do show only observed counts and backend-supplied reviews, with honest loading, empty, error and unavailable states."
    ],
    "donts": [
      "Don't restore superseded Courier Prime, DM Sans italics, lavender mesh tiles or pill navigation as the current visual system.",
      "Don't use teacher or student portraits, avatar builders or biometric identity to represent the login companion.",
      "Don't infer task failure from tracking loss, expression output or a color treatment.",
      "Don't send camera frames through cloud services or describe the local MJPEG connection as WebRTC.",
      "Don't imply deployed write permissions, available progress history or Photon delivery from a polished surface."
    ]
  }
}
